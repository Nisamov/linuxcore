```metadata.yml
name: grep
category: command
layer: userspace
difficulty: beginner
related:
  - sed
  - awk
  - rg
tags:
  - text-processing
  - regex
  - filtering
requires:
  - regex
platforms:
  - linux
  - macos
  - bsd
```

